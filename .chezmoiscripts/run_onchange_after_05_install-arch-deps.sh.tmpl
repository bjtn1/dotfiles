#!/bin/bash
# yay package list checksum: {{ include "dot_config/cachyos_yay_packages.txt" | sha256sum }}
# Installs yay/AUR packages on CachyOS. run_onchange_after_ (not
# run_once_) because .chezmoiscripts sorts before dot_config -- a plain
# run_once_ here would silently never find cachyos_yay_packages.txt on a
# fresh machine (it self-guards gracefully rather than erroring, but the
# practical effect was the same: package install never actually ran).
# The checksum comment above also means this re-runs automatically
# whenever the package list changes, not just once ever.
[[ "$(uname -s)" == "Linux" ]] || exit 0
command -v pacman &>/dev/null || exit 0

distro_id="$(. /etc/os-release && echo "$ID")"

if [[ "$distro_id" != "cachyos" ]]; then
    echo ">>> Unrecognized distro ($distro_id), skipping package install."
    exit 0
fi

yay_file="$HOME/.config/cachyos_yay_packages.txt"

if [[ ! -f "$yay_file" ]]; then
    echo ">>> $yay_file not found, skipping package install."
    exit 0
fi

if ! command -v yay &>/dev/null; then
    echo ">>> yay not found, bootstrapping it from the AUR..."
    sudo pacman -S --needed --noconfirm base-devel git
    yay_build_dir="$(mktemp -d)"
    git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$yay_build_dir"
    (cd "$yay_build_dir" && makepkg -si --needed --noconfirm)
    rm -rf "$yay_build_dir"
fi

if ! command -v yay &>/dev/null; then
    echo ">>> yay bootstrap failed, skipping package install."
    exit 0
fi

echo ">>> Installing yay/AUR packages for $distro_id..."
xargs -a "$yay_file" yay -S --needed --noconfirm
