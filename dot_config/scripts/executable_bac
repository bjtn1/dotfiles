#!/usr/bin/env bash

set -euo pipefail

CONFIG_DIR="$HOME/.config"
CACHE_DIR="$HOME/.cache"
CHEZMOI_CONFIG_DIR="$HOME/.local/share/chezmoi/dot_config"
CHEZMOI_CACHE_DIR="$HOME/.local/share/chezmoi/dot_cache"

backup_packages() {
  echo "📦 Backing up packages..."

  case "$(uname)" in
    Darwin)
      brew bundle dump -f --file="$CONFIG_DIR/brewfile.txt"
      echo "✅ Homebrew packages saved to $CONFIG_DIR/brewfile.txt"
      if command -v chezmoi >/dev/null; then
        chezmoi add "$CONFIG_DIR/brewfile.txt"
      fi
      ;;
    Linux)
      if [ -f /etc/os-release ]; then
        source /etc/os-release
        DISTRO="${ID,,}"  # lowercase distro name
      else
        DISTRO="linux"
      fi

      # I don't use pacman bruh
      # if command -v pacman >/dev/null; then
      #   pacman -Qqe > "$CONFIG_DIR/${DISTRO}_pacman_packages.txt"
      #   echo "✅ Pacman packages saved to $CONFIG_DIR/${DISTRO}_pacman_packages.txt"
      #   if command -v chezmoi >/dev/null; then
      #     chezmoi add "$CONFIG_DIR/${DISTRO}_pacman_packages.txt"
      #   fi
      #   echo "=============================================================================================================================================================================="
      # fi

      if command -v yay >/dev/null; then
        yay -Qqe > "$CONFIG_DIR/${DISTRO}_yay_packages.txt"
        echo "✅ Yay packages saved to $CONFIG_DIR/${DISTRO}_yay_packages.txt"
        if command -v chezmoi >/dev/null; then
          chezmoi add "$CONFIG_DIR/${DISTRO}_yay_packages.txt"
        fi
        echo "=============================================================================================================================================================================="
      fi
      ;;
    *)
      echo "❌ Unsupported OS"
      exit 1
      ;;
  esac
}

backup_configs() {
  echo
  echo "📦 Backing up configs..."

  if ! command -v chezmoi >/dev/null; then
    echo "⚠️ chezmoi not found, skipping config backup"
    return
  fi

  # Prompt for wallpapers directory (only matters the first time; once tracked,
  # it's picked up automatically like everything else below)
  if ! chezmoi managed 2>/dev/null | grep -q "^\.config/wallpapers$"; then
    read -p "Re-add ~/.config/wallpapers? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      chezmoi add "$CONFIG_DIR/wallpapers"
    fi
  fi

  # No hardcoded directory list: ask chezmoi what it already tracks and sync
  # exactly that. Deleted files (status code 'D' in the first column) need
  # `forget`, since neither `re-add` nor `add` remove entries on their own.
  # When a whole directory is deleted, chezmoi status lists the dir AND its
  # files as separate 'D' lines; forgetting the dir first un-manages the
  # files too, so a file's own forget can legitimately fail with "not
  # managed" -- that's not an error, just redundancy, so don't let it abort.
  echo "🗑️  Forgetting files deleted locally..."
  while IFS= read -r line; do
    code="${line:0:1}"
    path="${line:3}"
    if [[ "$code" == "D" && -n "$path" ]]; then
      echo "   $path"
      chezmoi forget --force "$HOME/$path" 2>/dev/null || true
    fi
  done < <(chezmoi status)

  # Derive top-level ~/.config directories that already have at least one
  # tracked file, instead of a hardcoded list -- computed fresh every run.
  # Directories chezmoi has never touched (gh/, kdeconnect/, browser
  # profiles, etc.) never appear here, so they stay untouched.
  declare -A tracked_dirs
  while IFS= read -r managed_path; do
    if [[ "$managed_path" == .config/*/* ]]; then
      top="${managed_path#.config/}"
      top="${top%%/*}"
      tracked_dirs["$top"]=1
    fi
  done < <(chezmoi managed)

  echo "💾 Re-syncing already-tracked config directories (new + modified files)..."
  for dir in "${!tracked_dirs[@]}"; do
    if [ -d "$CONFIG_DIR/$dir" ]; then
      chezmoi add "$CONFIG_DIR/$dir" || echo "⚠️ Failed to sync $dir"
    fi
  done

  # Catch-all for anything tracked directly under ~/.config (not in a
  # subdirectory) or outside ~/.config entirely, e.g. top-level dotfiles.
  chezmoi re-add || echo "⚠️ Failed to run chezmoi re-add"
}

show_help() {
  cat <<EOF
  Usage: $0 [OPTION]

  Backup system packages and configuration files.

  Options:
  -p, --packages    Backup installed packages only
  -c, --configs     Backup configuration files only
  -a, --all         Backup both packages and configs (default)
  -h, --help        Show this help message

  Examples:
  $0 -p             Backup only packages
  $0 --configs      Backup only config files
  $0                Backup everything (default action)
EOF
}

main() {
  # Parse options
  while [ $# -gt 0 ]; do
    case "$1" in
      -p|--packages)
        local do_packages=true
        shift
        ;;
      -c|--configs)
        local do_configs=true
        shift
        ;;
      -a|--all)
        local do_packages=true
        local do_configs=true
        shift
        ;;
      -h|--help)
        show_help
        exit 0
        ;;
      *)
        echo "❌ Invalid option: $1"
        show_help
        exit 1
        ;;
    esac
  done

  # Default to all if no specific options provided
  if [[ -z ${do_packages:-} && -z ${do_configs:-} ]]; then
    local do_packages=true
    local do_configs=true
  fi

  # Execute requested actions
  if [[ ${do_packages:-} == true ]]; then
    backup_packages
  fi

  if [[ ${do_configs:-} == true ]]; then
    backup_configs
  fi
}

main "$@"
