# Ignore these shits
.config/fish/fish_variables
.config/hypr/current_wallpaper
.config/noctalia/colors.json
.config/kdeglobals
.local/share/color-schemes
.config/kitty/current-theme.conf

# Hard-block: live Firefox profile data (cookies, saved logins, history).
# Config lives separately in .config/firefox-custom/, applied via
# scripts/apply-firefox-config -- never track anything under here directly.
.config/mozilla

# Nested git repos cloned by plugin managers (tpm, ya pack, etc.) anywhere
# under the tree — fully regenerable by their own tools, pure bloat/churn if
# hand-tracked. Applies to any future plugin dir too, not just known ones.
**/.git

# Retired per-distro/per-machine package snapshots — only cachyos_yay_packages.txt is tracked now
.config/arch_pacman_packages.txt
.config/arch_yay_packages.txt
.config/endeavouros_pacman_packages.txt
.config/endeavouros_yay_packages.txt

# macOS-only — ignore on Linux
{{ if ne .chezmoi.os "darwin" }}
Library
.skhdrc
.config/brewfile.txt
{{ end }}

# Linux-only — ignore on macOS
{{ if ne .chezmoi.os "linux" }}
.xinitrc
.config/hypr
.config/nwg-look
.config/pi_apt_packages.txt
.config/linux_brew_packages.txt
{{ end }}

# Pi-only — ignore on non-Pi (x86) Linux and macOS
{{ if or (ne .chezmoi.os "linux") (eq .chezmoi.arch "amd64") }}
.config/pi_apt_packages.txt
{{ end }}

# Arch-only — ignore on Pi
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") }}
.xinitrc
.config/hypr
.config/nwg-look
{{ end }}
